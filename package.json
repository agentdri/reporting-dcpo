{
  "name": "reportingdcpo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n PAC,VITE -c blue,green \"pac code run --port 8088\" \"vite\"",
    "dev:app": "vite",
    "dev:pac": "pac code run --port 8088",
    "build": "tsc -b && vite build",
